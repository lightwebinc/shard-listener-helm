{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "shard-listener values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "workloadType": { "type": "string", "enum": ["Deployment", "DaemonSet"] },
    "replicaCount": { "type": "integer", "minimum": 0 },
    "terminationGracePeriodSeconds": { "type": ["integer", "null"], "minimum": 0 },
    "resources": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
        "tag": { "type": "string" }
      },
      "required": ["repository", "pullPolicy"]
    },
    "networking": {
      "type": "object",
      "properties": {
        "mode": { "type": "string", "enum": ["multus", "host", "unicast"] }
      },
      "required": ["mode"]
    },
    "config": {
      "type": "object",
      "properties": {
        "listenPort":  { "type": "integer", "minimum": 1, "maximum": 65535 },
        "shardBits":   { "type": "integer", "minimum": 1, "maximum": 15 },
        "mcScope":     { "type": "string", "enum": ["link", "site", "org", "global"] },
        "sourceMode":  { "type": "string", "enum": ["asm", "ssm"] },
        "mode":        { "type": "string", "enum": ["collapsed", "receiver", "delivery"] },
        "deliveryAddrs": { "type": "array", "items": { "type": "string" } },
        "ssmBootstrap": {
          "type": "object",
          "properties": {
            "manifest":        { "type": "array", "items": { "type": "string" } },
            "beacon":          { "type": "array", "items": { "type": "string" } },
            "subtreeAnnounce": { "type": "array", "items": { "type": "string" } }
          }
        },
        "ssmPublishersStatic": { "type": "array", "items": { "type": "string" } },
        "ssmBootstrapRefresh": { "type": "string" },
        "localSource": { "type": "string" },
        "egressProto": { "type": "string", "enum": ["udp", "tcp"] },
        "headerEgressProto": { "type": "string", "enum": ["udp", "tcp"] },
        "beaconScope": { "type": "string", "enum": ["link", "site", "org", "global"] },
        "numWorkers":  { "type": "integer", "minimum": 1, "maximum": 1,
                         "description": "MUST be 1; multiple workers cause SO_REUSEPORT multicast duplication" },
        "debug":       { "type": "boolean" },
        "logFormat":     { "type": "string", "enum": ["text", "json"] },
        "logLevel":      { "type": "string", "enum": ["debug", "info", "warn", "error"] },
        "traceSampling": { "type": "number", "minimum": 0, "maximum": 1 },
        "egressDedupCap":       { "type": "integer", "minimum": 0 },
        "egressDedupTtl":       { "type": "string" },
        "deploymentId":         { "type": "string" },
        "nodeId":               { "type": "string" },
        "egressDedupBackend":   { "type": "string", "enum": ["", "memory", "redis", "aerospike", "none"] },
        "egressDedupRedisAddr": { "type": "string" },
        "egressDedupAerospikeHosts":     { "type": "string" },
        "egressDedupAerospikeNamespace": { "type": "string" },
        "egressDedupAerospikeSet":       { "type": "string" },
        "egressDedupPrefix":    { "type": "string" },
        "egressDedupTtlRedis":  { "type": "string" },
        "egressDedupLocalCap":  { "type": "integer", "minimum": 0 },
        "ingressSetBackend":    { "type": "string", "enum": ["", "memory", "redis", "aerospike", "none"] },
        "ingressSetRedisAddr":  { "type": "string" },
        "ingressSetAerospikeHosts":     { "type": "string" },
        "ingressSetAerospikeNamespace": { "type": "string" },
        "ingressSetAerospikeSet":       { "type": "string" },
        "ingressSetPrefix":     { "type": "string" },
        "ingressSetTtl":        { "type": "string" },
        "ingressSetLocalCap":   { "type": "integer", "minimum": 0 },
        "txidDedupAddr":        { "type": "string" },
        "txidDedupPrefix":      { "type": "string" },
        "txidDedupTtl":         { "type": "string" },
        "autoShardConfig": {
          "type": "object",
          "properties": {
            "enabled":                  { "type": "boolean" },
            "bootstrap":                { "type": "string", "enum": ["optional", "required"] },
            "pilotQuorum":              { "type": "integer", "minimum": 1 },
            "pilotHysteresis":          { "type": "string" },
            "shardIncludeFromManifest": { "type": "boolean" },
            "liveResharding":           { "type": "boolean" },
            "bridgingWindow":           { "type": "string" }
          }
        }
      }
    }
  }
}
